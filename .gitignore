# 运行态数据：含加密密钥 secret.key、代理凭据密文（settings.json / *.db）
# 目录由 app/config.py 的 ensure_dirs() 在启动时自动创建，无需纳入版本控制
/data/

# 环境用户数据（含浏览器 profile，可能存有登录态）
profiles/

# Python
__pycache__/
*.py[cod]
.venv/

# IDE / 工具临时目录（Trae/Claude 等编辑器与代理工具的工作区草稿）
.trae/
.claude/

# 浏览器内核二进制（体积大，按文档/脚本自行安装；install_fpchromium.sh 会自动下载）
tools/fp-chromium/

# 真机采集：自签证书与手机回传的读数（含真实设备信息，不入库）
.probe-certs/
phone_probe.json
